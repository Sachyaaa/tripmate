# Normalize all text files to LF on commit, regardless of OS
* text=auto eol=lf

# Explicitly mark binary files so Git never touches their line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.jar binary
*.class binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
