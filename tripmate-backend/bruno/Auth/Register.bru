meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Alice",
    "email": "alice@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("token", res.getBody().token);
    bru.setEnvVar("userId", res.getBody().user.id);
  }
}
