meta {
  name: Add Item
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/days/{{dayId}}/items
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Check in at hotel",
    "time": "14:00",
    "category": "HOTEL",
    "notes": "Booking ref #12345"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("itemId", res.getBody().id);
  }
}

docs {
  category is one of: HOTEL, FOOD, TRANSPORT, ACTIVITY, OTHER.
}
